# Yerel dosyanızı `.env` adıyla oluşturun; gerçek anahtarları commit etmeyin.
BG_HF_DATASET_REPO=
# Pull için 40 karakterli değişmez Hugging Face commit SHA.
BG_HF_REVISION=
# Hugging Face standart token değişkeni (yalnız push/özel repo pull için gerekir).
HF_TOKEN=

# Yanıt üretimi kullanılıyorsa:
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
